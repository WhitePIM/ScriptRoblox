-- TrapHub UI Script: Sleek Animated Loading, Resizable & Tabbed Controls

-- Services
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- References
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ScreenGui setup
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TrapHubUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Tween helper
local function tween(obj, props, dur)
    return TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
end

-- Forward declaration
local createUI

-- Reopen Button (hidden by default)
local openBtn = Instance.new("TextButton", screenGui)
openBtn.Name = "OpenButton"
openBtn.Size = UDim2.new(0, 40, 0, 40)
openBtn.Position = UDim2.new(0, 10, 0.5, -20)
openBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(0, 12)
openBtn.Text = ">>"
openBtn.TextColor3 = Color3.fromRGB(210,210,255)
openBtn.Visible = false
openBtn.ZIndex = 10

-- Clicking reopen
openBtn.MouseButton1Click:Connect(function()
    openBtn.Visible = false
    screenGui.Enabled = true
    -- animate window appearance
    if _G.MainWindow then tween(_G.MainWindow, {Position = UDim2.new(0.5, -190, 0.5, -170)}, 0.4):Play() end
end)

-- LOADING ANIMATION
local loadBg = Instance.new("Frame", screenGui)
loadBg.Name = "LoadBackground"
loadBg.Size = UDim2.new(0, 380, 0, 100)
loadBg.Position = UDim2.new(0.5, -190, 0.5, -50)
loadBg.BackgroundColor3 = Color3.fromRGB(36, 36, 48)
loadBg.Active = true
Instance.new("UICorner", loadBg).CornerRadius = UDim.new(0, 24)

local loadTxt = Instance.new("TextLabel", loadBg)
loadTxt.Size = UDim2.new(1, -20, 1, -20)
loadTxt.Position = UDim2.new(0, 10, 0, 10)
loadTxt.BackgroundTransparency = 1
loadTxt.Text = "Loading"
loadTxt.Font = Enum.Font.GothamBold
loadTxt.TextScaled = true
loadTxt.TextColor3 = Color3.fromRGB(210, 210, 255)
loadTxt.TextTransparency = 0.5

spawn(function()
    local dots = 0
    while loadBg.Parent do
        dots = (dots % 3) + 1
        loadTxt.Text = "Loading" .. string.rep(".", dots)
        tween(loadTxt, {TextTransparency = 0}, 0.3):Play()
        tween(loadTxt, {TextTransparency = 0.5}, 0.3):Play()
        task.wait(0.6)
    end
end)

task.delay(3, function()
    tween(loadBg, {BackgroundTransparency = 1}, 0.6):Play()
    tween(loadTxt, {TextTransparency = 1}, 0.6):Play()
    task.delay(0.6, function()
        loadBg:Destroy()
        createUI()
    end)
end)

-- MAIN UI CREATION
function createUI()
    -- Main window (resizable)
    local win = Instance.new("Frame", screenGui)
    win.Name = "MainWindow"
    win.Size = UDim2.new(0, 400, 0, 360)
    win.Position = UDim2.new(0.5, -200, 0.5, -180)
    win.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    win.BorderSizePixel = 0
    win.Active = true
    win.ClipsDescendants = true
    Instance.new("UICorner", win).CornerRadius = UDim.new(0, 24)

    -- UIPadding
    local padding = Instance.new("UIPadding", win)
    padding.PaddingLeft = UDim.new(0, 16)
    padding.PaddingRight = UDim.new(0, 16)
    padding.PaddingTop = UDim.new(0, 16)
    padding.PaddingBottom = UDim.new(0, 16)

    -- UIGridConstraint for auto layout
    local layout = Instance.new("UIListLayout", win)
    layout.Padding = UDim.new(0, 8)
    layout.FillDirection = Enum.FillDirection.Vertical

    -- Header
    local header = Instance.new("Frame", win)
    header.Size = UDim2.new(1, 0, 0, 44)
    header.BackgroundTransparency = 1
    header.LayoutOrder = 1
    header.Active = true

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(1, -140, 1, 0)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "TrapHub"
    title.Font = Enum.Font.GothamBold
    title.TextScaled = true
    title.TextColor3 = Color3.fromRGB(234, 234, 255)
    title.TextXAlignment = Enum.TextXAlignment.Left

    local function MakeBtn(sym, x)
        local b = Instance.new("TextButton", header)
        b.Size = UDim2.new(0, 28, 0, 28)
        b.Position = UDim2.new(1, x, 0, 8)
        b.Text = sym
        b.Font = Enum.Font.GothamBold
        b.TextScaled = true
        b.TextColor3 = Color3.fromRGB(200, 200, 255)
        b.BackgroundTransparency = 1
        return b
    end
    local btnMin = MakeBtn("—", -112)
    local btnHide = MakeBtn("✕", -64)
    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = i.Position; startPos = win.Position
        end
    end)

    -- Tabs
    local tabHolder = Instance.new("Frame", win)
    tabHolder.Size = UDim2.new(1, -32, 0, 44)
    tabHolder.BackgroundTransparency = 1
    tabHolder.LayoutOrder = 2

    local tabs, pages = {}, {}
    for i, name in ipairs({"Misc", "Troll"}) do
        local t = Instance.new("TextButton", tabHolder)
        t.Name = name .. "Tab"
        t.Size = UDim2.new(0.48, 0, 1, 0)
        t.Position = UDim2.new((i - 1) * 0.5 + 0.01, 0, 0, 0)
        t.Text = name
        t.Font = Enum.Font.Gotham
        t.TextScaled = true
        t.BackgroundColor3 = Color3.fromRGB(60, 60, 85)
        t.BorderSizePixel = 0
        Instance.new("UICorner", t).CornerRadius = UDim.new(0, 12)
        tabs[name] = t

        local p = Instance.new("Frame", win)
        p.Name = name .. "Page"
        p.Size = UDim2.new(1, 0, 1, -140)
        p.Position = UDim2.new(0, 0, 0, 120)
        p.BackgroundTransparency = 1
        p.Visible = false
        p.LayoutOrder = 3
        pages[name] = p
    end

    local current
    local function Select(name)
        if current then pages[current].Visible = false end
        for k, v in pairs(tabs) do
            tween(v, {BackgroundColor3 = (k == name) and Color3.fromRGB(100, 100, 140) or Color3.fromRGB(60, 60, 85)}, 0.2):Play()
        end
        pages[name].Visible = true
        current = name
    end
    for name, btn in pairs(tabs) do
        btn.MouseButton1Click:Connect(function() Select(name) end)
    end
    Select("Misc")

    -- Draggable window
    do local dragging, dragStart, startPos
        win.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true; dragStart = i.Position; startPos = win.Position
                i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
            end
        end)
        win.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = i.Position - dragStart
                win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    -- Resize grip
    local grip = Instance.new("Frame", win)
    grip.Size = UDim2.new(0, 16, 0, 16)
    grip.Position = UDim2.new(1, -16, 1, -16)
    grip.BackgroundTransparency = 1
    grip.Active = true
    grip.ZIndex = 2
    grip.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingResize = true; resizeStart = i.Position; startSize = win.Size
            i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then draggingResize = false end end)
        end
    end)
    grip.InputChanged:Connect(function(i)
        if draggingResize and i.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = i.Position - resizeStart
            win.Size = UDim2.new(startSize.X.Scale, startSize.X.Offset + delta.X, startSize.Y.Scale, startSize.Y.Offset + delta.Y)
        end
    end)

    -- Minimize & Hide
    btnMin.MouseButton1Click:Connect(function() tween(win, {Size = UDim2.new(0, 380, 0, 120)}, 0.3):Play(); for _, p in pairs(pages) do p.Visible = false end end)
    btnHide.MouseButton1Click:Connect(function()
    screenGui.Enabled = false
    openBtn.Visible = true
    openBtn.Position = UDim2.new(0, -40, 0.5, -20)
    tween(openBtn, {Position = UDim2.new(0, 10, 0.5, -20)}, 0.4):Play()
end)

    -- Misc Page: Fly, Jump & Speed
    do local m = pages.Misc
        local function addInput(label, y)
            local lbl = Instance.new("TextLabel", m)
            lbl.Size = UDim2.new(0, 140, 0, 32); lbl.Position = UDim2.new(0, 10, 0, y)
            lbl.BackgroundTransparency = 1; lbl.Text=label; lbl.Font=Enum.Font.Gotham; lbl.TextScaled=true; lbl.TextColor3=Color3.fromRGB(214,214,255)
            local inp=Instance.new("TextBox", m)
            inp.Size=UDim2.new(0,100,0,32); inp.Position=UDim2.new(0,160,0,y)
            inp.Text="60"; inp.ClearTextOnFocus=false; inp.Font=Enum.Font.Gotham; inp.TextScaled=true; inp.BackgroundColor3=Color3.fromRGB(80,80,100)
            Instance.new("UICorner", inp).CornerRadius=UDim.new(0,8)
            return inp
        end
        local inpFly=addInput("Fly Speed:",0)
        local inpJump=addInput("Jump Power:",50)
        local inpSpeed=addInput("Walk Speed:",100)
        local btnFly=Instance.new("TextButton", m)
        btnFly.Size=UDim2.new(0,180,0,48); btnFly.Position=UDim2.new(0.5,-90,0,150); btnFly.Text="Toggle Fly"; btnFly.Font=Enum.Font.Gotham; btnFly.TextScaled=true; btnFly.BackgroundColor3=Color3.fromRGB(90,150,220)
        Instance.new("UICorner",btnFly).CornerRadius=UDim.new(0,12)
        local btnJump=Instance.new("TextButton", m)
        btnJump.Size=UDim2.new(0,180,0,48); btnJump.Position=UDim2.new(0.5,-90,0,210); btnJump.Text="Set Jump"; btnJump.Font=Enum.Font.Gotham; btnJump.TextScaled=true; btnJump.BackgroundColor3=Color3.fromRGB(110,210,110)
        Instance.new("UICorner",btnJump).CornerRadius=UDim.new(0,12)
        local btnWalk=Instance.new("TextButton", m)
        btnWalk.Size=UDim2.new(0,180,0,48); btnWalk.Position=UDim2.new(0.5,-90,0,270); btnWalk.Text="Set Walk"; btnWalk.Font=Enum.Font.Gotham; btnWalk.TextScaled=true; btnWalk.BackgroundColor3=Color3.fromRGB(220,180,90)
        Instance.new("UICorner",btnWalk).CornerRadius=UDim.new(0,12)
        local flying, conn
        btnFly.MouseButton1Click:Connect(function()
            flying=not flying
            if flying then
                local speed=tonumber(inpFly.Text) or 60
                conn=RunService.RenderStepped:Connect(function()
                    local hrp=(player.Character or player.CharacterAdded:Wait()):FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dir=Vector3.new(); local cam=workspace.CurrentCamera.CFrame
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir+=cam.LookVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir-=cam.LookVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir-=cam.RightVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir+=cam.RightVector end
                        hrp.Velocity=(dir.Magnitude>0 and dir.Unit*speed) or Vector3.new()
                    end
                end)
                btnFly.Text="Stop Fly"
            else
                if conn then conn:Disconnect() end; local hrp=(player.Character or player.CharacterAdded:Wait()):FindFirstChild("HumanoidRootPart") if hrp then hrp.Velocity=Vector3.new() end; btnFly.Text="Toggle Fly"
            end
        end)
        btnJump.MouseButton1Click:Connect(function()
            local jp=tonumber(inpJump.Text) or 50; local hum=(player.Character or player.CharacterAdded:Wait()):FindFirstChildOfClass("Humanoid") if hum then hum.JumpPower=jp end
        end)
        btnWalk.MouseButton1Click:Connect(function()
            local ws=tonumber(inpSpeed.Text) or 16; local hum=(player.Character or player.CharacterAdded:Wait()):FindFirstChildOfClass("Humanoid") if hum then hum.WalkSpeed=ws end
        end)
    end

    -- Troll Page: Spin
    do local t=pages.Troll
        local inpSpin=Instance.new("TextBox",t)
        inpSpin.Size=UDim2.new(0,100,0,32); inpSpin.Position=UDim2.new(0,160,0,10); inpSpin.Text="5"; inpSpin.ClearTextOnFocus=false; inpSpin.Font=Enum.Font.Gotham; inpSpin.TextScaled=true; inpSpin.BackgroundColor3=Color3.fromRGB(80,60,60)
        Instance.new("UICorner",inpSpin).CornerRadius=UDim.new(0,8)
        local lbl=Instance.new("TextLabel",t)
        lbl.Size=UDim2.new(0,140,0,32); lbl.Position=UDim2.new(0,10,0,10); lbl.BackgroundTransparency=1; lbl.Text="Spin Speed:"; lbl.Font=Enum.Font.Gotham; lbl.TextScaled=true; lbl.TextColor3=Color3.fromRGB(214,214,255)
        local btn=Instance.new("TextButton",t)
        btn.Size=UDim2.new(0,180,0,48); btn.Position=UDim2.new(0.5,-90,0,80); btn.Text="Toggle Spin"; btn.Font=Enum.Font.Gotham; btn.TextScaled=true; btn.BackgroundColor3=Color3.fromRGB(210,90,90)
        Instance.new("UICorner",btn).CornerRadius=UDim.new(0,12)
        local spinning,av
        btn.MouseButton1Click:Connect(function()
            spinning=not spinning
            if spinning then av=Instance.new("BodyAngularVelocity",(player.Character or player.CharacterAdded:Wait()):FindFirstChild("HumanoidRootPart")); av.MaxTorque=Vector3.new(0,1e5,0); av.AngularVelocity=Vector3.new(0,tonumber(inpSpin.Text) or 5,0); btn.Text="Stop Spin"
            else if av then av:Destroy() end; btn.Text="Toggle Spin" end
        end)
    end

    -- Toggle UI with K
    UserInputService.InputBegan:Connect(function(input,processed)
        if not processed and input.KeyCode==Enum.KeyCode.K then screenGui.Enabled=not screenGui.Enabled end
    end)
end
